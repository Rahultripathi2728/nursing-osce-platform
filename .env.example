VITE_FIREBASE_PROJECT_ID=your-nursing-osce
VITE_FIREBASE_STORAGE_BUCKET=your-nursing-osce.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
